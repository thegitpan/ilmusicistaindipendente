---
import Base from "../layouts/Base.astro";
import { SITE } from "../config/site";

// La "channel list" di cosa arriverà: stessi nomi del catalogo in PIANO_PROGETTO.md.
const channels = [
  {
    name: "Stage plot e channel list",
    text: "Disegna il palco trascinando strumenti e musicisti: la channel list si scrive da sola. Esci con un PDF pronto per il fonico.",
    kind: "Strumento",
  },
  {
    name: "Analizzatore del brano",
    text: "Loudness, picchi e dinamica del tuo master, e quanto lo abbasseranno Spotify e YouTube. Il file non lascia il tuo computer.",
    kind: "Strumento",
  },
  {
    name: "Bacheca bandi e contest",
    text: "Bandi, contest e open call per musicisti, raccolti ogni settimana e ordinati per scadenza.",
    kind: "Ogni settimana",
  },
  {
    name: "Guide pratiche",
    text: "SIAE, distribuzione digitale, ISRC, agibilità per i concerti: spiegate semplici, partendo dalle fonti ufficiali.",
    kind: "Ogni settimana",
  },
  {
    name: "News per chi fa musica",
    text: "Streaming, diritti, live e industria: le notizie che servono a chi suona, non il gossip.",
    kind: "Ogni giorno",
  },
  {
    name: "Pagina artista e smart link",
    text: "Il tuo press kit online e un link unico per ogni uscita, da mettere in bio.",
    kind: "Con l'account",
  },
  {
    name: "Calcolatori",
    text: "Quanto ti resta in tasca da una data e quanto rendono davvero i tuoi ascolti in streaming.",
    kind: "Strumento",
  },
];
---

<Base>
  <section class="hero wrap">
    <p class="mono eyebrow">ilmusicistaindipendente.it · in arrivo</p>
    <h1>
      Tutto quello che serve per portare avanti la tua musica <span class="tape">indipendente</span>.
    </h1>
    <p class="lede">
      Strumenti gratuiti, bandi, guide pratiche e news per band, cantautori e produttori italiani.
      Stiamo montando il palco.
    </p>

    {
      SITE.newsletterFormUrl ? (
        <a class="cta" href={SITE.newsletterFormUrl}>
          Avvisami all'apertura
        </a>
      ) : (
        <div class="soundcheck">
          <p class="mono">Soundcheck</p>
          <p>
            La newsletter apre a giorni: una volta a settimana i bandi in scadenza, la guida
            della settimana e le news che contano.
          </p>
        </div>
      )
    }
  </section>

  <section class="channels wrap" aria-labelledby="channels-title">
    <div class="channels-head">
      <h2 id="channels-title">Cosa stiamo montando</h2>
      <p class="mono">Channel list · v0.1</p>
    </div>
    <ol class="ch-list">
      {
        channels.map((ch, i) => (
          <li>
            <span class="mono ch">CH {String(i + 1).padStart(2, "0")}</span>
            <div class="ch-body">
              <h3>{ch.name}</h3>
              <p>{ch.text}</p>
            </div>
            <span class="mono kind">{ch.kind}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="rules wrap" aria-label="Come funziona">
    <div>
      <h2>Gratis.</h2>
      <p>Tutti gli strumenti sono gratuiti, oggi e domani.</p>
    </div>
    <div>
      <h2>Senza registrarti.</h2>
      <p>Gli strumenti si usano subito. L'account serve solo per salvare il tuo lavoro.</p>
    </div>
    <div>
      <h2>Da qui.</h2>
      <p>Pensato per chi suona in Italia: burocrazia, bandi e locali di casa nostra.</p>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: 72px 56px;
  }

  .eyebrow {
    color: var(--ink-soft);
    margin-bottom: 20px;
  }

  h1 {
    font-size: clamp(2.75rem, 9vw, 6.5rem);
    max-width: 14ch;
  }

  h1 .tape {
    display: inline-block;
    transform: rotate(-1.5deg);
    padding-inline: 0.15em;
  }

  .lede {
    margin-top: 28px;
    max-width: 52ch;
    font-size: 1.1875rem;
    color: var(--ink-soft);
  }

  .soundcheck {
    margin-top: 36px;
    max-width: 560px;
    border: 2px dashed var(--ink);
    border-radius: var(--radius);
    padding: 16px 20px;
  }

  .soundcheck .mono {
    color: var(--tape-ink);
    margin-bottom: 6px;
  }

  .cta {
    display: inline-block;
    margin-top: 36px;
    background: var(--ink);
    color: var(--paper);
    font-weight: 600;
    text-decoration: none;
    padding: 14px 22px;
    border-radius: var(--radius);
  }

  .cta:hover {
    background: var(--tape);
    color: var(--on-tape);
  }

  .channels {
    padding-block: 24px;
  }

  .channels-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
    border-bottom: 2px solid var(--ink);
    padding-bottom: 14px;
  }

  .channels-head h2 {
    font-size: clamp(2rem, 5vw, 3rem);
  }

  .channels-head .mono {
    color: var(--ink-soft);
  }

  .ch-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ch-list li {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 4px 16px;
    padding-block: 18px;
    border-bottom: 1px solid var(--line);
  }

  .ch {
    color: var(--tape-ink);
    padding-top: 4px;
  }

  .ch-body h3 {
    font-size: 1.625rem;
    margin-bottom: 6px;
  }

  .ch-body p {
    color: var(--ink-soft);
    max-width: 62ch;
  }

  .kind {
    grid-column: 2;
    justify-self: start;
    color: var(--ink-soft);
    background: var(--paper-2);
    padding: 3px 8px;
    border-radius: var(--radius);
    font-size: 0.75rem;
  }

  @media (min-width: 720px) {
    .ch-list li {
      grid-template-columns: 88px 1fr auto;
      align-items: start;
    }

    .kind {
      grid-column: 3;
      margin-top: 4px;
    }
  }

  .rules {
    display: grid;
    gap: 28px;
    padding-block: 64px 0;
  }

  .rules h2 {
    font-size: 2.25rem;
    margin-bottom: 8px;
  }

  .rules p {
    color: var(--ink-soft);
    max-width: 36ch;
  }

  @media (min-width: 720px) {
    .rules {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
