---
import { SITE } from "../config/site";
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${SITE.name}, home`}>
      <svg class="mark" viewBox="0 0 32 32" aria-hidden="true">
        <circle cx="16" cy="16" r="13" fill="none" stroke="currentColor" stroke-width="3"></circle>
        <circle cx="10.5" cy="13" r="2.4" fill="currentColor"></circle>
        <circle cx="21.5" cy="13" r="2.4" fill="currentColor"></circle>
        <circle cx="16" cy="21.5" r="2.4" fill="currentColor"></circle>
      </svg>
      <span>Il Musicista<br />Indipendente</span>
    </a>
    <span class="mono status">Lavori in corso</span>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 2px solid var(--ink);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 72px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.15rem;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .mark {
    width: 34px;
    height: 34px;
    flex: none;
    color: var(--tape);
  }

  .status {
    color: var(--ink-soft);
    border: 1px solid var(--line);
    padding: 4px 8px;
    border-radius: var(--radius);
    white-space: nowrap;
  }
</style>
